{
  "manifest_version": 3,
  "name": "LinkedIn Outreach AI",
  "version": "3.2.0",
  "description": "Draft a short, specific LinkedIn message you review and send yourself. Works free, on your device.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Outreach AI"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
